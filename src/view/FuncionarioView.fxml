<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" styleClass="tela" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FuncionarioController">
   <children>

      <!-- Cartão do formulário -->
      <VBox maxWidth="360.0" minWidth="360.0" prefWidth="360.0" spacing="16.0" styleClass="card">
         <children>
            <Label styleClass="titulo-card" text="Dados do funcionário" />
            <GridPane hgap="10.0" vgap="14.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="125.0" prefWidth="125.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="rotulo" text="Nome" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNome" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label styleClass="rotulo" text="CPF" GridPane.rowIndex="1" />
                  <TextField fx:id="txtCpf" maxWidth="Infinity" promptText="Somente números" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label styleClass="rotulo" text="Cargo" GridPane.rowIndex="2" />
                  <TextField fx:id="txtCargo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label styleClass="rotulo" text="Data de admissão" GridPane.rowIndex="3" />
                  <DatePicker fx:id="dpDataAdmissao" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <FlowPane hgap="8.0" vgap="8.0">
               <children>
                  <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#acaoSalvar" styleClass="botao-primario" text="Salvar" />
                  <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#acaoLimpar" styleClass="botao-secundario" text="Limpar" />
                  <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#acaoExcluir" styleClass="botao-perigo" text="Excluir" />
               </children>
            </FlowPane>
         </children>
      </VBox>

      <!-- Cartão da tabela -->
      <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
            <Label styleClass="titulo-card" text="Funcionários cadastrados" />
            <TableView fx:id="tblFuncionarios" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                  <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
                  <TableColumn fx:id="colCpf" prefWidth="120.0" text="CPF" />
                  <TableColumn fx:id="colCargo" prefWidth="120.0" text="Cargo" />
                  <TableColumn fx:id="colDataAdmissao" prefWidth="120.0" text="Admissão" />
               </columns>
            </TableView>
         </children>
      </VBox>

   </children>
</HBox>
