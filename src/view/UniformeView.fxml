<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" styleClass="tela" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UniformeController">
   <children>

      <!-- Cartão do formulário -->
      <VBox maxWidth="340.0" minWidth="340.0" prefWidth="340.0" spacing="16.0" styleClass="card">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label maxWidth="Infinity" styleClass="titulo-card" text="Dados do uniforme" HBox.hgrow="ALWAYS" />
                  <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imgs/uniforme-de-futebol.png" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
            <GridPane hgap="10.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="80.0" prefWidth="80.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="rotulo" text="Peça" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbPeca" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label styleClass="rotulo" text="Tamanho" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cbTamanho" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label styleClass="rotulo" text="Cor" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cbCor" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label styleClass="rotulo" text="Material" GridPane.rowIndex="3" />
                  <ComboBox fx:id="cbMaterial" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <Label styleClass="rotulo" text="Preço" GridPane.rowIndex="4" />
                  <TextField fx:id="txtPreco" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            <FlowPane hgap="8.0" vgap="8.0">
               <children>
                  <Button fx:id="btnNovo" mnemonicParsing="false" onAction="#acaoNovo" styleClass="botao-secundario" text="Novo" />
                  <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#acaoSalvar" styleClass="botao-primario" text="Salvar" />
                  <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#acaoExcluir" styleClass="botao-perigo" text="Excluir" />
               </children>
            </FlowPane>
         </children>
      </VBox>

      <!-- Cartão da tabela -->
      <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
            <Label styleClass="titulo-card" text="Uniformes cadastrados" />
            <TableView fx:id="tblUniformes" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                  <TableColumn fx:id="colPeca" prefWidth="110.0" text="Peça" />
                  <TableColumn fx:id="colTamanho" prefWidth="85.0" text="Tamanho" />
                  <TableColumn fx:id="colCor" prefWidth="95.0" text="Cor" />
                  <TableColumn fx:id="colMaterial" prefWidth="110.0" text="Material" />
                  <TableColumn fx:id="colPreco" prefWidth="100.0" text="Preço" />
               </columns>
            </TableView>
         </children>
      </VBox>

   </children>
</HBox>
