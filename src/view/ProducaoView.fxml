<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" styleClass="tela" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProducaoController">
   <children>

      <!-- Cartão do formulário -->
      <VBox maxWidth="440.0" minWidth="440.0" prefWidth="440.0" spacing="16.0" styleClass="card">
         <children>
            <Label styleClass="titulo-card" text="Registrar produção" />
            <GridPane hgap="10.0" vgap="14.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="125.0" prefWidth="125.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="rotulo" text="Funcionário" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbFuncionario" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label styleClass="rotulo" text="Uniforme" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cbUniforme" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label styleClass="rotulo" text="Quantidade" GridPane.rowIndex="2" />
                  <TextField fx:id="txtQuantidade" maxWidth="Infinity" promptText="Unidades produzidas" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label styleClass="rotulo" text="Data de produção" GridPane.rowIndex="3" />
                  <DatePicker fx:id="dpDataProducao" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <FlowPane hgap="8.0" vgap="8.0">
               <children>
                  <Button fx:id="btnNovo" mnemonicParsing="false" onAction="#acaoNovo" styleClass="botao-secundario" text="Novo" />
                  <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#acaoSalvar" styleClass="botao-primario" text="Salvar Produção" />
                  <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#acaoExcluir" styleClass="botao-perigo" text="Excluir Registro" />
               </children>
            </FlowPane>
         </children>
      </VBox>

      <!-- Cartão da tabela -->
      <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
            <Label styleClass="titulo-card" text="Registros de produção" />
            <TableView fx:id="tblRegistros" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                  <TableColumn fx:id="colFuncionario" prefWidth="120.0" text="Funcionário" />
                  <TableColumn fx:id="colUniforme" prefWidth="130.0" text="Uniforme" />
                  <TableColumn fx:id="colQuantidade" prefWidth="85.0" text="Quantidade" />
                  <TableColumn fx:id="colData" prefWidth="90.0" text="Data" />
               </columns>
            </TableView>
         </children>
      </VBox>

   </children>
</HBox>
