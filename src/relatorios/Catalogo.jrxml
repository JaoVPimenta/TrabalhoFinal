	</style>
	<queryString language="SQL">
		<![CDATA[SELECT
			id,
			CASE peca
				WHEN 'CAMISETA' THEN 'Camiseta'
				WHEN 'CALCA'    THEN 'Calça'
				WHEN 'BONE'     THEN 'Boné'
				ELSE peca
			END AS peca_formatada,
			tamanho,
			cor,
			CASE material
				WHEN 'ALGODAO'   THEN 'Algodão'
				WHEN 'POLIESTER' THEN 'Poliéster'
				ELSE material
			END AS material_formatado,
			preco_base
		FROM uniforme
		ORDER BY peca ASC, tamanho ASC, cor ASC]]>
	</queryString>
	<field name="id" class="java.lang.Integer"/>
	<field name="peca_formatada" class="java.lang.String"/>
	<field name="tamanho" class="java.lang.String"/>
	<field name="cor" class="java.lang.String"/>
	<field name="material_formatado" class="java.lang.String"/>
	<field name="preco_base" class="java.math.BigDecimal"/>
