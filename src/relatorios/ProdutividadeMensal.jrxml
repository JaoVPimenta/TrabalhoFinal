<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProdutividadeMensal" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7dae4030-6f06-4939-960b-4f786694a4fb">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adaptador db_sgu"/>
	<style name="ZebraRow" mode="Opaque" backcolor="#FFFFFF">
		<box>
			<bottomPen lineWidth="0.5" lineColor="#E2E8F0"/>
		</box>
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F8FAFC"/>
		</conditionalStyle>
	</style>
	<parameter name="MES" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[11]]></defaultValueExpression>
	</parameter>
	<parameter name="ANO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2026]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
			f.id AS id_funcionario,
			f.nome AS nome_funcionario,
			f.cargo,
			COUNT(rp.id) AS total_lancamentos,
			COALESCE(SUM(rp.quantidade), 0) AS total_produzido
		FROM funcionario f
		LEFT JOIN registro_producao rp
			ON rp.id_funcionario = f.id
		   AND MONTH(rp.data_producao) = $P{MES}
		   AND YEAR(rp.data_producao) = $P{ANO}
		GROUP BY f.id, f.nome, f.cargo
		ORDER BY f.nome ASC]]>
	</queryString>
	<field name="id_funcionario" class="java.lang.Integer"/>
	<field name="nome_funcionario" class="java.lang.String"/>
	<field name="cargo" class="java.lang.String"/>
	<field name="total_lancamentos" class="java.lang.Long"/>
	<field name="total_produzido" class="java.math.BigDecimal"/>
	<variable name="TOTAL_GERAL_PRODUZIDO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_produzido}]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
